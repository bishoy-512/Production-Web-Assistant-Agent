# Project Information
APP_NAME=Production Web Assistant Agent
APP_ENV=development
VERSION=0.1.0
PROJECT_ROOT=""

# Logging Settings
DEBUG=true
LOG_LEVEL="DEBUG"
LOG_RENDER="console"
LOG_DIR="storage/logs"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# DataBase Connection
POSTGRES_HOST=localhost
POSTGRES_DB=web-assistant-agent
POSTGRES_USER=
POSTGRES_PORT=5432
POSTGRES_PASSWORD=

POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10